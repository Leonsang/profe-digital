# Google AI Studio key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Modelo de voz (Live API). Alternativas: gemini-3-flash-live, gemini-2.5-flash-native-audio-latest
LIVE_MODEL=gemini-3.8-live
VOICE=Aoede
LANGUAGE=es-US
AFFECTIVE_DIALOG=1
PROACTIVE_AUDIO=1

# Vacío = sin Nano Banana (el nivel gratuito tiene cuota 0). Ej: gemini-3.1-flash-image
IMAGE_MODEL=

ALLOWED_ORIGINS=http://localhost:5173
